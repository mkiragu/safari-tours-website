# Payment Gateway Configuration

# Stripe Configuration (https://stripe.com/docs/keys)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
VITE_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# M-Pesa Daraja API Configuration (https://developer.safaricom.co.ke)
# Use sandbox credentials for testing, production for live
VITE_MPESA_ENVIRONMENT=sandbox
VITE_MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
VITE_MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
VITE_MPESA_SHORTCODE=174379
VITE_MPESA_PASSKEY=your_mpesa_passkey_here
VITE_MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
